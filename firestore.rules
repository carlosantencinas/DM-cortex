rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function campaignDoc(campaignId) { return get(/databases/$(database)/documents/campaigns/$(campaignId)); }
    function isDm(campaignId) { return signedIn() && campaignDoc(campaignId).data.dmUid == request.auth.uid; }
    function isMember(campaignId) { return signedIn() && exists(/databases/$(database)/documents/campaigns/$(campaignId)/members/$(request.auth.uid)); }
    function isCharacterOwner() { return signedIn() && resource.data.ownerUid == request.auth.uid; }
    function canJoinCampaign(campaignId) { return signedIn() && isMember(campaignId); }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
      match /characters/{characterId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /campaignInvites/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.status == 'active'
        && campaignDoc(request.resource.data.campaignId).data.dmUid == request.auth.uid;
      allow update, delete: if signedIn() && isDm(resource.data.campaignId);
    }

    match /campaigns/{campaignId} {
      allow create: if signedIn()
        && request.resource.data.dmUid == request.auth.uid
        && request.resource.data.status == 'active';
      allow read: if isDm(campaignId) || isMember(campaignId);
      allow update, delete: if isDm(campaignId)
        && request.resource.data.dmUid == resource.data.dmUid;

      match /members/{userId} {
        allow read: if isDm(campaignId) || (isMember(campaignId) && userId == request.auth.uid);
        allow create: if isDm(campaignId)
          || (signedIn()
            && userId == request.auth.uid
            && request.resource.data.role == 'player'
            && exists(/databases/$(database)/documents/campaignInvites/$(request.resource.data.inviteCodeUsed))
            && get(/databases/$(database)/documents/campaignInvites/$(request.resource.data.inviteCodeUsed)).data.campaignId == campaignId
            && get(/databases/$(database)/documents/campaignInvites/$(request.resource.data.inviteCodeUsed)).data.status == 'active');
        allow update: if isDm(campaignId)
          || (signedIn() && userId == request.auth.uid && resource.data.role == request.resource.data.role);
        allow delete: if isDm(campaignId)
          || (signedIn() && userId == request.auth.uid && resource.data.role == 'player');
      }

      match /characters/{characterId} {
        allow read: if isDm(campaignId) || (isMember(campaignId) && resource.data.ownerUid == request.auth.uid);
        allow create: if isMember(campaignId)
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.campaignId == campaignId;
        allow update: if isMember(campaignId)
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.campaignId == campaignId;
        allow delete: if isDm(campaignId) || (isMember(campaignId) && resource.data.ownerUid == request.auth.uid);
      }
    }
  }
}
