rules_version = '2';

// Subí estas reglas en Firebase Console > Firestore Database > Reglas
// (o con `firebase deploy --only firestore:rules` si usás Firebase CLI).
service cloud.firestore {
  match /databases/{database}/documents {

    match /campaigns/{campaignId} {
      // Cualquier usuario logueado puede leer los datos básicos de la
      // campaña (nombre, etc.) — útil para unirse con un código de invitación.
      allow read: if request.auth != null;
      // Solo se puede crear una campaña como uno mismo (dmUid = tu uid).
      allow create: if request.auth != null && request.resource.data.dmUid == request.auth.uid;
      // Solo el DM dueño puede modificar/borrar la campaña.
      allow update, delete: if request.auth != null && resource.data.dmUid == request.auth.uid;

      match /characters/{charUid} {
        // El DM de la campaña puede leer TODAS las hojas (dashboard centralizado).
        // Un jugador solo puede leer su propia hoja.
        allow read: if request.auth != null && (
          request.auth.uid == charUid ||
          get(/databases/$(database)/documents/campaigns/$(campaignId)).data.dmUid == request.auth.uid
        );
        // Cada jugador solo puede crear/editar SU PROPIA hoja.
        allow create, update: if request.auth != null && request.auth.uid == charUid;
        // El jugador dueño o el DM pueden borrar la hoja.
        allow delete: if request.auth != null && (
          request.auth.uid == charUid ||
          get(/databases/$(database)/documents/campaigns/$(campaignId)).data.dmUid == request.auth.uid
        );
      }
    }
  }
}
