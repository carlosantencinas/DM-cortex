rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function campaignDoc(campaignId) {
      return get(/databases/$(database)/documents/campaigns/$(campaignId));
    }

    function campaignAfter(campaignId) {
      return getAfter(/databases/$(database)/documents/campaigns/$(campaignId));
    }

    function isDm(campaignId) {
      return signedIn() && campaignDoc(campaignId).data.dmUid == request.auth.uid;
    }

    function isDmAfter(campaignId) {
      return signedIn() && campaignAfter(campaignId).data.dmUid == request.auth.uid;
    }

    function isMember(campaignId) {
      return signedIn() && exists(/databases/$(database)/documents/campaigns/$(campaignId)/members/$(request.auth.uid));
    }

    match /campaignInvites/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.status == 'active'
        && isDmAfter(request.resource.data.campaignId);
      allow update, delete: if signedIn() && isDm(resource.data.campaignId);
    }

    match /campaigns/{campaignId} {
      allow create: if signedIn()
        && request.resource.data.dmUid == request.auth.uid
        && request.resource.data.status == 'active';

      allow read: if isDm(campaignId) || isMember(campaignId);

      allow update, delete: if isDm(campaignId)
        && request.resource.data.dmUid == resource.data.dmUid;

      match /members/{userId} {
        allow read: if isDm(campaignId) || isMember(campaignId);

        allow create: if isDmAfter(campaignId)
          || (
            signedIn()
            && userId == request.auth.uid
            && request.resource.data.role == 'player'
            && exists(/databases/$(database)/documents/campaignInvites/$(request.resource.data.inviteCodeUsed))
            && get(/databases/$(database)/documents/campaignInvites/$(request.resource.data.inviteCodeUsed)).data.campaignId == campaignId
            && get(/databases/$(database)/documents/campaignInvites/$(request.resource.data.inviteCodeUsed)).data.status == 'active'
          );

        allow update: if isDm(campaignId)
          || (signedIn() && userId == request.auth.uid && resource.data.role == request.resource.data.role);

        allow delete: if isDm(campaignId)
          || (signedIn() && userId == request.auth.uid && resource.data.role == 'player');
      }

      match /characters/{charUid} {
        allow read: if isDm(campaignId) || (isMember(campaignId) && request.auth.uid == charUid);
        allow create, update: if isMember(campaignId) && request.auth.uid == charUid;
        allow delete: if isDm(campaignId) || (isMember(campaignId) && request.auth.uid == charUid);
      }
    }
  }
}
